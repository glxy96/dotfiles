{
  "agent": {
    "default_model": {
      "provider": "local",
      "model": "popos",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "language_models": {
    "openai_compatible": {
      "local": {
        "api_url": "http://pop-os.tail45812c.ts.net:8081",
        "available_models": [
          {
            "name": "popos",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
